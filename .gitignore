# ─── Dependencias ───────────────────────────────────────────────────────────
node_modules/

# ─── Build ──────────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/

# ─── Variables de entorno (NO subir secretos) ───────────────────────────────
.env
.env.local
.env.*.local
!.env.example

# ─── Logs ───────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

