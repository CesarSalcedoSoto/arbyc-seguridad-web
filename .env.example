# ─── Arbyc Seguridad — Variables de entorno ────────────────────────────────
# Copia este archivo a ".env" y completa los valores reales.

# ── Servidor web / API ──
PORT=3001

# ── Dominio de correo corporativo ──
DOMAIN=arbycseguridad.cl
MAIL_HOSTNAME=mail.arbycseguridad.cl

# ── Administrador maestro ──
ADMIN_EMAIL=admin@arbycseguridad.cl
ADMIN_PASSWORD=ArbycSeguridad2026!Master
JWT_SECRET=arbyc-seguridad-jwt-secret-key-2026-production

# ── Envío de correo del formulario de contacto ──
# Destino del correo de cotización
CONTACT_TO_EMAIL=ventas@arbycseguridad.cl
# Remitente que verá el destinatario (debe ser una casilla válida del dominio)
MAIL_FROM=no-reply@arbycseguridad.cl

# Configuración SMTP saliente (mail server).
# Si SMTP_HOST se deja vacío, el backend respalda los mensajes en
# data/db/contact-messages.json (útil solo para desarrollo local).
SMTP_HOST=mail.arbycseguridad.cl
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@arbycseguridad.cl
SMTP_PASS=tu_contraseña_smtp
